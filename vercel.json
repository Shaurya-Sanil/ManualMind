{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://manualmind-backend.onrender.com/api/:path*"
    },
    {
      "source": "/reports/figures/:path*",
      "destination": "https://manualmind-backend.onrender.com/reports/figures/:path*"
    }
  ]
}
